# ==============================================================================
# 浙大科创中心水博园区宿舍 <-> 科研工位 千兆 IPv6 隧道配置文件模板 (.env.example)
# 复制为 .env 后填入实际参数，AI Agent 将读取 .env 自动完成双端部署
# ==============================================================================

# --- 1. 宿舍路由器 (OpenWrt / 小米路由器解锁 SSH) ---
DORM_ROUTER_LAN_IP="192.168.31.1"
DORM_ROUTER_SSH_USER="root"
# 若工位没有域名/DDNS，工位节点将通过校内网直连此备用校园网 IP 或通过 SSH 主动上报
DORM_WAN_FALLBACK_IP="10.98.86.100"

# 宿舍局域网分配的 IPv6 前缀 (由工位节点经 GRE 隧道路由并执行单次 NAT66)
DORM_IPV6_PREFIX="2001:da8:e000:c011::/64"
DORM_ULA_PREFIX="fd00:3131:3131::/64"

# --- 2. 工位节点类型与连接参数 ---
# 可选值: "linux" (推荐: Debian/Ubuntu x86 小主机，实测 840+ Mbps) 或 "openwrt" (工位硬路由，实测 ~270 Mbps)
OFFICE_NODE_TYPE="linux"
OFFICE_NODE_SSH_HOST="192.168.31.120"
OFFICE_NODE_SSH_USER="root"
OFFICE_WAN_IF="enp3s0"
OFFICE_WAN_FALLBACK_IP="10.98.64.100"

# 可选: 克隆工位原设备的 WAN MAC 与 DHCPv6 DUID (免重新认证直接继承工位原 IP，留空则使用网卡原生 MAC)
OFFICE_CLONE_MAC=""
OFFICE_CLONE_DUID=""

# --- 3. 无线应急管理热点 (仅 OFFICE_NODE_TYPE="linux" 且具备无线网卡时生效) ---
ENABLE_RESCUE_WIFI="1"
RESCUE_WIFI_IF="wlp2s0"
RESCUE_WIFI_SSID="NUC-Rescue"
RESCUE_WIFI_PSK="ChangeMe123456"
RESCUE_WIFI_CIDR="192.168.99.1/24"

# --- 4. L2TP 账号分配策略 ---
# 设为 "0" (推荐): 工位节点不拨 L2TP，由宿舍路由器独占唯一 L2TP 账号；工位校外 IPv4 通过 GRE 隧道借道宿舍出网
# 设为 "1": 工位节点独立拨号连接 ZJU L2TP
ENABLE_OFFICE_L2TP="0"
OFFICE_L2TP_SERVER="lns.zju.edu.cn"
OFFICE_L2TP_USERNAME=""
OFFICE_L2TP_PASSWORD=""

# --- 5. GRE 隧道内部互联地址 (一般无需修改) ---
GRE_TUNNEL_MTU="1476"
GRE_OFFICE_IPV6="fd00:cafe::1/64"
GRE_DORM_IPV6="fd00:cafe::2/64"
GRE_OFFICE_IPV4="10.255.255.1/30"
GRE_DORM_IPV4="10.255.255.2/30"

# --- 6. 可选: Cloudflare DDNS 自动更新 (若无域名可留空，系统自带校内网 SSH 主动推送对端 IP 机制) ---
CF_ZONE_ID=""
CF_API_TOKEN=""
DORM_DDNS_HOST=""
DORM_CF_RECORD_A_ID=""
OFFICE_DDNS_HOST=""
OFFICE_CF_RECORD_A_ID=""
OFFICE_CF_RECORD_AAAA_ID=""
